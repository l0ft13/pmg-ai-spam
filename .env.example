# --- Proxmox Mail Gateway -------------------------------------------------
# Use a dedicated PMG user with the "Quarantine Manager" (qmanager) role.
# The username must include its realm: name@pmg for users created in PMG.
PMG_URL=https://pmg.example.local:8006
PMG_USERNAME=triage@pmg
PMG_PASSWORD=
# "Release + whitelist" and "Delete + blocklist" change PMG's mail filter rule
# lists, which needs the Administrator role instead. These are the list names
# under Mail Filter > Who Objects.
PMG_WELCOMELIST_NAME=Welcomelist
PMG_BLOCKLIST_NAME=Blocklist
# PMG normally has a self-signed certificate. Either point at a copy of its
# certificate (preferred) or switch verification off.
PMG_CA_FILE=
PMG_TLS_INSECURE=false
# How many days of quarantine to look back over (PMG keeps spam 7 days by default).
QUARANTINE_DAYS=7

# --- Database (MySQL / MariaDB) -------------------------------------------
# DB_DRIVER=memory keeps everything in RAM and is for demos and tests only.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mailtriage
DB_PASSWORD=
DB_NAME=mailtriage

# --- AI provider -----------------------------------------------------------
# anthropic = Claude API (message text leaves your network)
# ollama    = local model (mail stays on site)
# heuristic = no AI, verdict from the PMG score only (demos and tests)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Longest message body, in characters, sent to the model. Longer bodies are
# cut and the model is told so.
BODY_CHAR_LIMIT=8000

# --- Triage behaviour -------------------------------------------------------
POLL_INTERVAL_MINUTES=5
# Spam verdicts at or above this confidence are filed under "Obvious spam"
# instead of the review list.
SPAM_HIDE_CONFIDENCE=90

# --- Review screen -----------------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8025
WEB_USER=admin
WEB_PASSWORD=
