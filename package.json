{
  "name": "exchange-spam-triage",
  "version": "0.1.0",
  "private": true,
  "description": "AI triage and review screen for the Proxmox Mail Gateway spam quarantine",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "mock-pmg": "tsx scripts/mock-pmg.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "fastify": "^5.12.8",
    "mailparser": "^3.14.5",
    "mysql2": "^3.24.6",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
